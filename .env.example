# Copy this file to `.env` and fill in real values. Never commit `.env`.

LACROSSE_EMAIL=
LACROSSE_PASSWORD=

POSTGRES_DB=lacrosse
POSTGRES_USER=lacrosse
POSTGRES_PASSWORD=

# If the data directory is ever empty on startup (lost volume, recreated
# container), automatically restore from the most recent nightly backup
# instead of starting empty. Set to "false" to always start empty.
POSTGRES_AUTO_RESTORE_ON_INIT=true

# How often (minutes) the collector polls the La Crosse API.
COLLECTION_INTERVAL_MINUTES=15

# On first run (empty database), how far back to look for readings, unless
# LACROSSE_BACKFILL_FULL_HISTORY is enabled below.
LACROSSE_INITIAL_LOOKBACK_MINUTES=60

# Overlap window subtracted from the last stored reading on subsequent runs,
# to avoid gaps from slow-reporting sensors. Inserts are idempotent, so a
# larger overlap just means occasional harmless re-fetches.
LACROSSE_OVERLAP_MINUTES=10

# Timezone passed to the La Crosse API, e.g. "America/Los_Angeles".
LACROSSE_TIMEZONE=UTC

# Leave blank to collect all locations on the account, or set to an index
# (0, 1, ...) to restrict to a single location.
LACROSSE_LOCATION_INDEX=

# --- Full-history backfill ---
# If TRUE, each collection cycle compares the oldest reading currently stored
# against LACROSSE_BACKFILL_START_DATE. If there's still a gap, it pulls one
# more LACROSSE_BACKFILL_CHUNK_DAYS-wide chunk further back in time, in
# addition to the normal forward collection. There's no separate "run once"
# step and no state to track -- progress is just whatever's already in the
# database, so this can be turned on at any point (not just before the first
# run) and safely survives restarts. It naturally stops once the oldest
# stored reading reaches the target date, and naturally resumes if you later
# lower LACROSSE_BACKFILL_START_DATE to go back even further.
LACROSSE_BACKFILL_FULL_HISTORY=false
LACROSSE_BACKFILL_START_DATE=2000-01-01
LACROSSE_BACKFILL_CHUNK_DAYS=7

# Pause before the backfill's API call, to dodge what looks like a
# short-window rate limit on the get_sensors endpoint: two such calls a few
# seconds apart get rejected with 401, even across different login sessions.
# Increase if you still see 401 errors on the "Backfill ..." log line.
LACROSSE_BACKFILL_DELAY_SECONDS=30

# After this many consecutive backfill attempts make no progress, stop
# trying until the collector restarts -- some accounts/devices only expose
# a limited amount of history (observed ~7 days) regardless of how far back
# LACROSSE_BACKFILL_START_DATE asks for, and retrying that same window
# forever would just waste an API call and the full delay above every cycle.
LACROSSE_BACKFILL_STALL_LIMIT=3

# --- Nightly backups ---
# Host folder for backup files (bind-mounted, not a Docker-managed volume) --
# lets you browse/copy them directly and point a separate backup/sync tool
# at the same path for off-site redundancy. Docker creates it if it doesn't
# already exist. Required.
BACKUP_HOST_PATH=C:/backups/lacrosse_backups

# Cron schedule (or @daily / @weekly / @hourly / etc). Default: once a day.
# Example for 2am nightly: BACKUP_SCHEDULE=0 2 * * *
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# --- Read-only role, used by the webapp service ---
# Provisioned automatically on first startup of an empty database (see
# db/init/00-create-readonly-role.sh). Required -- the webapp service will
# refuse to start without it.
#
# IMPORTANT: that init script only runs the first time Postgres initializes
# an empty data directory. If your pgdata volume already existed before you
# added the webapp service, set this password here, then create the role
# by hand once:
#   docker compose exec postgres psql -U ${POSTGRES_USER:-lacrosse} -d ${POSTGRES_DB:-lacrosse} -c \
#     "CREATE ROLE lacrosse_readonly LOGIN PASSWORD 'the-password-you-set-below';"
#   docker compose exec postgres psql -U ${POSTGRES_USER:-lacrosse} -d ${POSTGRES_DB:-lacrosse} -c \
#     "GRANT CONNECT ON DATABASE ${POSTGRES_DB:-lacrosse} TO lacrosse_readonly; GRANT USAGE ON SCHEMA public TO lacrosse_readonly; GRANT SELECT ON ALL TABLES IN SCHEMA public TO lacrosse_readonly; ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO lacrosse_readonly;"
WEBAPP_DB_USER=lacrosse_readonly
WEBAPP_DB_PASSWORD=

# Host port for the dashboard (http://<this-machine>:<port>). Reachable from
# your LAN by default; no login is in front of it yet, so don't forward this
# port to the internet without adding one first.
WEBAPP_PORT=8080

# --- Web dashboard rate limits ---
# Format: "<count>/<second|minute|hour|day>", e.g. "60/minute" or "10/second".
# An invalid value fails the webapp container at startup rather than
# silently misapplying -- check `docker compose logs webapp` if it won't
# start after changing one of these.
#
# Two layers apply together on /api/devices and /api/readings: a per-source-
# IP limit and a per-browser-session limit (an anonymous cookie, not a
# login -- see app.py). Whichever is hit first blocks the request. Loosen
# these if legitimate use gets blocked (e.g. selecting many sensors at
# once triggers many parallel /api/readings calls); tightening them below
# what normal dashboard use actually needs will make the dashboard trip its
# own limits.
WEBAPP_RATE_LIMIT_DEVICES_PER_IP=60/minute
WEBAPP_RATE_LIMIT_DEVICES_PER_SESSION=30/minute
WEBAPP_RATE_LIMIT_READINGS_PER_IP=120/minute
WEBAPP_RATE_LIMIT_READINGS_PER_SESSION=60/minute

# A third, coarser layer covers every path under /api/ -- current and
# future -- as a backstop in case an endpoint is ever added without its own
# specific limit above (e.g. by a future me forgetting to add one). It
# should rarely if ever trigger during normal use, since it's meant to sit
# above the two pairs above, not alongside them.
#
# Do NOT lower these to "tune" dashboard behavior -- adjust the
# WEBAPP_RATE_LIMIT_DEVICES_*/READINGS_* values above for that instead.
# Weakening this pair only reduces the protection it exists to provide for
# endpoints that don't have their own limit; it has no benefit for ones that
# already do. Raise it if it ever proves too tight in practice, but treat
# any change to these two as a deliberate security decision, not a
# performance tweak.
WEBAPP_RATE_LIMIT_BLANKET_PER_IP=300/minute
WEBAPP_RATE_LIMIT_BLANKET_PER_SESSION=150/minute
